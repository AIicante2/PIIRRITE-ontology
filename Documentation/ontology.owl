<?xml version="1.0"?>
<rdf:RDF xmlns="http://piirrite.univ-lyon1.fr/ontology/core#"
     xml:base="http://piirrite.univ-lyon1.fr/ontology/core"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prez="https://prez.dev/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vaem="http://www.linkedmodel.org/schema/vaem#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/">
    <owl:Ontology rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#">
        <owl:versionIRI rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core/1.0.0"/>
        <owl:imports rdf:resource="http://qudt.org/2.1/schema/qudt#"/>
        <owl:imports rdf:resource="http://schemas.opengis.net/geosparql/1.0/geosparql_vocab_all.rdf"/>
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
        <owl:imports rdf:resource="https://saref.etsi.org/core/v4.1.1/"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-20</terms:created>
        <terms:creator>Laboratoire d&apos;InfoRmatique en Image et Systèmes d&apos;information</terms:creator>
        <terms:description xml:lang="en">PIIRRITE (Pedestrian InclusIve indooR-outdooR ITinerariEs) is an ontology for inclusive pedestrian navigation. It relies on GeoSPARQL, SAREF, OWL-Time, SKOS, etc. It is developed using the SAMOD methodology through successive modelets driven by a set of competency questions reflecting user requirements.</terms:description>
        <terms:description xml:lang="fr">PIIRRITE (Pedestrion InclusIve indooR-outdooR ITinerariEs) est une ontologie pour la navigation piétonne inclusive. Elle repose sur GeoSPARQL, SAREF, OWL-TIME, SKOS, etc. Elle est développée en utilisant la méthodologie SAMOD à travers des modelets successifs dirigés par un ensembe de questions de compétences qui reflètent des exigences utilisateurs.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="fr">Ontologie PIIRRITE Core</terms:title>
        <terms:title xml:lang="en">PIIRRITE Core Ontology</terms:title>
        <vann:preferredNamespacePrefix>piirrite</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://piirrite.univ-lyon1.fr/ontology/core#</vann:preferredNamespaceUri>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    



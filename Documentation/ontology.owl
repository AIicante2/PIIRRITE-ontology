    <!-- http://www.w3.org/2001/XMLSchema#anySimpleType -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#anySimpleType"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#hasAllowedValue -->


    <owl:ObjectProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#hasAllowedValue">
        <rdfs:domain rdf:resource="https://saref.etsi.org/core/v4.1.1/Property"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="fr">Lie une propriété saref à la description d&apos;une valeur qu&apos;elle peut prendre.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a saref property to the description of a value it can have.</rdfs:comment>
        <rdfs:label xml:lang="fr">a pour valeur autorisée</rdfs:label>
        <rdfs:label xml:lang="en">has allowed value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#hasCondition -->


    <owl:ObjectProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#hasCondition">
        <rdfs:domain rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Requirement"/>
        <rdfs:range rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Condition"/>
        <rdfs:comment xml:lang="fr">Lie une exigence a une condition.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a requirement to a condition.</rdfs:comment>
        <rdfs:label xml:lang="fr">a pour condition de validité</rdfs:label>
        <rdfs:label xml:lang="en">has condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#hasDistanceFactor -->


    <owl:ObjectProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#hasDistanceFactor">
        <rdfs:domain rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#AtomicCondition"/>
        <rdfs:range rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#DistanceFactor"/>
        <rdfs:comment xml:lang="fr">Lie une condition atomique à un facteur de distance.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links an atomic conditon to a distance factor.</rdfs:comment>
        <rdfs:label xml:lang="fr">a pour facteur de distance</rdfs:label>
        <rdfs:label xml:lang="en">has distance factor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#hasFlexibility -->


    <owl:ObjectProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#hasFlexibility">
        <rdfs:domain rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Requirement"/>
        <rdfs:range rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Flexibility"/>
        <rdfs:comment xml:lang="fr">Lie une exigence à un réel entre 0 et 1 représentant le niveau de flexibilité que doit fournir le matching avec les propriétés contextuelles de l&apos;environnement.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a requirement to a float between 0 and 1 representing the level of flexibility needed for the matching with contextual environmental properties.</rdfs:comment>
        <rdfs:label xml:lang="fr">a pour flexibilité</rdfs:label>
        <rdfs:label xml:lang="en">has flexibility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#hasImportance -->


    <owl:ObjectProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#hasImportance">
        <rdfs:domain rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Requirement"/>
        <rdfs:range rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Importance"/>
        <rdfs:comment xml:lang="fr">Lie une exigence à son importance.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a requirement to its importance</rdfs:comment>
        <rdfs:label xml:lang="fr">a pour importance</rdfs:label>
        <rdfs:label xml:lang="en">has importance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#hasOperand -->


    <owl:ObjectProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#hasOperand">
        <rdfs:domain rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#ComposedCondition"/>
        <rdfs:range rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Condition"/>
        <rdfs:comment xml:lang="fr">Lie une condition composée à l&apos;un de ses opérandes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a composed condition to one of its operands.</rdfs:comment>
        <rdfs:label xml:lang="fr">a pour opérande</rdfs:label>
        <rdfs:label xml:lang="en">has operand</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#hasRequirement -->


    <owl:ObjectProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#hasRequirement">
        <rdfs:domain rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#UserProfile"/>
        <rdfs:range rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Requirement"/>
        <rdfs:comment xml:lang="fr">Lie un profil utilisateur à une exigence.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a user profile to a requirement.</rdfs:comment>
        <rdfs:label xml:lang="fr">a pour exigence</rdfs:label>
        <rdfs:label xml:lang="en">has requirement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#hasTargetProperty -->


    <owl:ObjectProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#hasTargetProperty">
        <rdfs:domain rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#AtomicCondition"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/v4.1.1/Property"/>
        <rdfs:comment xml:lang="fr">Lie une condition à la propriété contextuelle à laquelle elle se rapporte.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a condition to the contextual property to which it relates.</rdfs:comment>
        <rdfs:label xml:lang="fr">a pour propriété cible</rdfs:label>
        <rdfs:label xml:lang="en">has target property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#hasTemporalValidity -->


    <owl:ObjectProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#hasTemporalValidity">
        <rdfs:domain rdf:resource="https://saref.etsi.org/core/v4.1.1/PropertyValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:comment xml:lang="fr">Lie une valeur de propriété saref à sa fenêtre de validité temporelle, i.e. l&apos;interval temporel pendant lequel la valeur est considérée valide. En l&apos;absence de fenêtre de validité temporelle, celle-ci est considérée éternelle.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a saref property value to its temporal validity window, i.e. the temporal interval during which the value is considered valid. If the temporal validity window isn&apos;t specified, it is considered eternal.</rdfs:comment>
        <rdfs:label xml:lang="fr">a pour fenêtre de validité temporelle</rdfs:label>
        <rdfs:label xml:lang="en">has temporal validity window</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#passesBy -->


    <owl:ObjectProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#passesBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#DistanceFactor"/>
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#NavigablePath"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#PointOfInterest"/>
        <rdfs:comment xml:lang="fr">Lie un chemin navigable à un point d&apos;intérêt par lequel il passe</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a navigable path to a point of interest it passes by</rdfs:comment>
        <rdfs:label xml:lang="fr">passe par</rdfs:label>
        <rdfs:label xml:lang="en">passes by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#usesOperator -->


    <owl:ObjectProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#usesOperator">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#Condition"/>
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#DistanceFactor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Operator"/>
        <rdfs:comment xml:lang="fr">Lie une condition à l&apos;opérateur qui doit être employé lors du matching avec les propriétés contextulles de l&apos;environnement.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a condition to the operator to use for the matching with contextual environmental properties.</rdfs:comment>
        <rdfs:label xml:lang="en">uses operator</rdfs:label>
        <rdfs:label xml:lang="fr">utilise l&apos;opérateur</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/ansiSQLName -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/ansiSQLName"/>
    


    <!-- http://qudt.org/schema/qudt/cName -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/cName"/>
    


    <!-- http://qudt.org/schema/qudt/oracleSQLName -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/oracleSQLName"/>
    


    <!-- http://qudt.org/schema/qudt/protocolBuffersName -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/protocolBuffersName"/>
    


    <!-- http://qudt.org/schema/qudt/pythonName -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/pythonName"/>
    


    <!-- http://qudt.org/schema/qudt/vbName -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/vbName"/>
    


    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    


    <!-- https://saref.etsi.org/core/v4.1.1/hasPropertyValue -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/core/v4.1.1/hasPropertyValue"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#hasDistanceType -->


    <owl:DatatypeProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#hasDistanceType">
        <rdfs:domain rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#DistanceFactor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Lie un facteur de distance à la façon dont elle est calculée, e.g. à vol d&apos;oiseau, en suivant les chemins humains, en utilisant la propriété &apos;passe par&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a distance factor to the way it is computed, e.g. from bird flight, by following humain pathways, by using the &apos;passes by&apos; property.</rdfs:comment>
        <rdfs:label xml:lang="fr">a pour type de distance</rdfs:label>
        <rdfs:label xml:lang="en">has distance type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#hasRequiredValue -->


    <owl:DatatypeProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#hasRequiredValue">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#AtomicCondition"/>
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#DistanceFactor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anySimpleType"/>
        <rdfs:comment xml:lang="fr">Lie une condition à une valeur considérée comme valide.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a condition to a value that is considered valid.</rdfs:comment>
        <rdfs:label xml:lang="fr">a pour valeur exigée</rdfs:label>
        <rdfs:label xml:lang="en">has required value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#hasValue -->


    <owl:DatatypeProperty rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#hasValue">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#Flexibility"/>
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#Importance"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:comment xml:lang="fr">Lie une enveloppe de valeur à sa valeur.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a value wrapper to its value.</rdfs:comment>
        <rdfs:label xml:lang="fr">a pour valeur</rdfs:label>
        <rdfs:label xml:lang="en">has value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://qudt.org/schema/qudt/bits -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/bits"/>
    


    <!-- http://qudt.org/schema/qudt/length -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/length"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#AreaOfInterest -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#AreaOfInterest">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/v4.1.1/FeatureOfInterest"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/core/v4.1.1/hasPropertyValue"/>
                <owl:someValuesFrom rdf:resource="https://saref.etsi.org/core/v4.1.1/PropertyValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.opengis.net/ont/sf#Polygon"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#PointOfInterest"/>
        <owl:disjointWith rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#PolylineOfInterest"/>
        <rdfs:comment xml:lang="en">A 2D area over a geographic space represented as a polygon and contextualised by properties which are inherited by all context-faring entities contained within the area</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une région 2D d&apos;un espace géographique représentée par un polygon et contextualisée par des propriétés qui sont hérités par toutes les entitées porteuses de contexte contenues dans la région</rdfs:comment>
        <rdfs:label xml:lang="en">Area of Interest</rdfs:label>
        <rdfs:label xml:lang="fr">Région d&apos;intérêt</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#AtomicCondition -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#AtomicCondition">
        <rdfs:subClassOf rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Condition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasTargetProperty"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://saref.etsi.org/core/v4.1.1/Property"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#usesOperator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#ComparisonOperator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasDistanceFactor"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#DistanceFactor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasRequiredValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#anySimpleType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#ComposedCondition"/>
        <rdfs:comment xml:lang="en">A condition that a spatial element should meet in order to be considered valid from the corresponding property standpoint.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une condition qu&apos;un élément spatial doit respecter pour être considéré valide du point de vue de la propriété correspondante.</rdfs:comment>
        <rdfs:label xml:lang="en">Atomic condition</rdfs:label>
        <rdfs:label xml:lang="fr">Condition atomique</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#ComparisonOperator -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#ComparisonOperator">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#EQUALS"/>
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#GREATER_THAN"/>
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#LESSER_THAN"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Operator"/>
        <rdfs:comment xml:lang="en">An operator usable for the matching between a validity condition and the value of a contextual property. e.g. equality, membership, difference, superiority, etc.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Un opérateur utilisable lors du matching entre une condition de validité et une valeur de propriété contextuelle. e.g. égalité, appartenance, différence, supériorité, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Comparison operator</rdfs:label>
        <rdfs:label xml:lang="fr">Opérateur de comparaison</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#ComposedCondition -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#ComposedCondition">
        <rdfs:subClassOf rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Condition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasOperand"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Condition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#usesOperator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#LogicalOperator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasOperand"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Condition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A condition composed of a logical operator and one or two operands that are themselves conditions.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une condition composée d&apos;un opérateur logique et d&apos;un ou deux opérande étant eux-mêmes des conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">Composed condition</rdfs:label>
        <rdfs:label xml:lang="fr">Condition composée</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#Condition -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#Condition">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#AtomicCondition"/>
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#ComposedCondition"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">A condition that a spatial element should meet in order to be considered valid.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une condition qu&apos;un élément spatial doit respecter pour être considéré valide.</rdfs:comment>
        <rdfs:label xml:lang="en">Condition</rdfs:label>
        <rdfs:label xml:lang="fr">Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#DistanceFactor -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#DistanceFactor">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#passesBy"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#PointOfInterest"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#usesOperator"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#ComparisonOperator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasDistanceType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasRequiredValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#anySimpleType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A distance factor for the corresponding condition to be considered respected.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Un facteur de distance pour que la condition correspondante soit considérée respectée.</rdfs:comment>
        <rdfs:label xml:lang="en">Distance factor</rdfs:label>
        <rdfs:label xml:lang="fr">Facteur de distance</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#Flexibility -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#Flexibility">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:onDataRange>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A value wrapper representing the flexilibty of a requirement using a float between 0 and 1.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une enveloppe de valeur décrivant la flexibilité d&apos;une exigence par un réel entre 0 et 1.</rdfs:comment>
        <rdfs:label xml:lang="en">Flexibility</rdfs:label>
        <rdfs:label xml:lang="fr">Flexibilité</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#Importance -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#Importance">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:onDataRange>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A value wrapper representing the importance of a requirement using a float between 0 and 1. The importance can also be equal to INF if the requirement is mandatory.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une enveloppe de valeur décrivant l&apos;importance d&apos;une exigence par un réel entre 0 et 1. L&apos;importance peut également valoir INF si le besoin doit obligatoirement être respecté lors de la génération d&apos;itinéraires.</rdfs:comment>
        <rdfs:label xml:lang="en">Importance</rdfs:label>
        <rdfs:label xml:lang="fr">Importance</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#LogicalOperator -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#LogicalOperator">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#AND"/>
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#NOT"/>
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#OR"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Operator"/>
        <rdfs:comment xml:lang="en">An operator usable for combining conditions into a composed validity expression.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Un opérateur utilisable pour combiner des conditions en une expression de validité composée.</rdfs:comment>
        <rdfs:label xml:lang="en">Logical operator</rdfs:label>
        <rdfs:label xml:lang="fr">Opérateur logique</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#NavigablePath -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#NavigablePath">
        <rdfs:subClassOf rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#PolylineOfInterest"/>
        <rdfs:comment xml:lang="en">A polyline of interest that can be traveled through</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une polyligne d&apos;intérêt dont le parcours est possible</rdfs:comment>
        <rdfs:label xml:lang="fr">Chemin navigable</rdfs:label>
        <rdfs:label xml:lang="en">Navigable path</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#Operator -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#Operator">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#ComparisonOperator"/>
                    <rdf:Description rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#LogicalOperator"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">A comparison or logical operator.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Un opérateur logique ou de comparaison.</rdfs:comment>
        <rdfs:label xml:lang="en">Operator</rdfs:label>
        <rdfs:label xml:lang="fr">Opérateur</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#PointOfInterest -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#PointOfInterest">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/v4.1.1/FeatureOfInterest"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/core/v4.1.1/hasPropertyValue"/>
                <owl:someValuesFrom rdf:resource="https://saref.etsi.org/core/v4.1.1/PropertyValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.opengis.net/ont/sf#Point"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#PolylineOfInterest"/>
        <rdfs:comment xml:lang="en">A dimensionless entity located in a geographic space and contextualised by properties</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une entité sans dimension localisée dans un espace géographique et contextualisée par des propriétés</rdfs:comment>
        <rdfs:label xml:lang="fr">Point d&apos;intérêt</rdfs:label>
        <rdfs:label xml:lang="en">Point of Interest</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#PolylineOfInterest -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#PolylineOfInterest">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/v4.1.1/FeatureOfInterest"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/core/v4.1.1/hasPropertyValue"/>
                <owl:someValuesFrom rdf:resource="https://saref.etsi.org/core/v4.1.1/PropertyValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.opengis.net/ont/sf#LineString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A sequence of 1 or more consecutive segments located in a geographic space and contextualised by properties</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une séquence d&apos;1 ou plus segments consécutifs localisée dans un espace géographique et contextualisée par des propriétés</rdfs:comment>
        <rdfs:label xml:lang="fr">Polyligne d&apos;intérêt</rdfs:label>
        <rdfs:label xml:lang="en">Polyline Of Interest</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#Requirement -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#Requirement">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasCondition"/>
                <owl:allValuesFrom rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Condition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasFlexibility"/>
                <owl:allValuesFrom rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Flexibility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasImportance"/>
                <owl:allValuesFrom rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Importance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasCondition"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Condition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A user requirement, represented by its importance, its rigor and one or many validity conditions</rdfs:comment>
        <rdfs:comment xml:lang="fr">Une exigence d&apos;un utilisateur, représentée par son importance, sa rigueur et une ou plusieurs conditions de validité.</rdfs:comment>
        <rdfs:label xml:lang="fr">Exigence</rdfs:label>
        <rdfs:label xml:lang="en">Requirement</rdfs:label>
    </owl:Class>
    


    <!-- http://piirrite.univ-lyon1.fr/ontology/core#UserProfile -->


    <owl:Class rdf:about="http://piirrite.univ-lyon1.fr/ontology/core#UserProfile">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#hasRequirement"/>
                <owl:allValuesFrom rdf:resource="http://piirrite.univ-lyon1.fr/ontology/core#Requirement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A user profile, described by a set of requirement (eg. &apos;I want to use elevators&apos;) rather than by personnal characteristics (eg. I&apos;m in a wheelchair).</rdfs:comment>
        <rdfs:comment xml:lang="fr">Le profil d&apos;un utilisateur, décrit par un ensemble d&apos;exigences (eg. &apos;Je veux prendre l&apos;ascenseur&apos;) plutôt que par des caractéristiques personnels (eg. &apos;Je suis en fauteuil&apos;).</rdfs:comment>
        <rdfs:label xml:lang="fr">Profil utilisateur</rdfs:label>
        <rdfs:label xml:lang="en">User profile</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Aspect -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Aspect"/>
    


    <!-- http://qudt.org/schema/qudt/EnumeratedQuantity -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/EnumeratedQuantity"/>
    


    <!-- http://qudt.org/schema/qudt/SignednessType -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/SignednessType"/>
    


    <!-- http://qudt.org/schema/qudt/StringEncodingType -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/StringEncodingType"/>
    


    <!-- http://qudt.org/schema/qudt/SymmetricRelation -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/SymmetricRelation"/>
    


    <!-- http://qudt.org/schema/qudt/Verifiable -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Verifiable"/>
    


    <!-- http://www.linkedmodel.org/schema/vaem#CatalogEntry -->


    <owl:Class rdf:about="http://www.linkedmodel.org/schema/vaem#CatalogEntry"/>
    


    <!-- http://www.opengis.net/ont/geosparql#Feature -->


    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature"/>
    


    <!-- http://www.opengis.net/ont/sf#LineString -->



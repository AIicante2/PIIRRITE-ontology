  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A value wrapper representing the importance of a requirement using a float between 0 and 1. The importance can also be equal to INF if the requirement is mandatory."
  }, {
    "@language" : "fr",
    "@value" : "Une enveloppe de valeur décrivant l'importance d'une exigence par un réel entre 0 et 1. L'importance peut également valoir INF si le besoin doit obligatoirement être respecté lors de la génération d'itinéraires."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Importance"

  }, {
    "@language" : "fr",
    "@value" : "et"
  } ]
}, {
  "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#AreaOfInterest",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A 2D area over a geographic space represented as a polygon and contextualised by properties which are inherited by all context-faring entities contained within the area"
  }, {
    "@language" : "fr",
    "@value" : "Une région 2D d'un espace géographique représentée par un polygon et contextualisée par des propriétés qui sont hérités par toutes les entitées porteuses de contexte contenues dans la région"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Area of Interest"
  }, {
    "@language" : "fr",
    "@value" : "Région d'intérêt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Feature"
  }, {
    "@id" : "https://saref.etsi.org/core/v4.1.1/FeatureOfInterest"
  }, {
    "@id" : "_:genid13"
  }, {
    "@id" : "_:genid14"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#PointOfInterest"
  }, {
    "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#PolylineOfInterest"
  } ]
}, {
  "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#AtomicCondition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],

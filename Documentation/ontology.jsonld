}, {
  "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#",
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-07-20"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Laboratoire d'InfoRmatique en Image et Systèmes d'information"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "PIIRRITE (Pedestrian InclusIve indooR-outdooR ITinerariEs) is an ontology for inclusive pedestrian navigation. It relies on GeoSPARQL, SAREF, OWL-Time, SKOS, etc. It is developed using the SAMOD methodology through successive modelets driven by a set of competency questions reflecting user requirements."
  }, {
    "@language" : "fr",
    "@value" : "PIIRRITE (Pedestrion InclusIve indooR-outdooR ITinerariEs) est une ontologie pour la navigation piétonne inclusive. Elle repose sur GeoSPARQL, SAREF, OWL-TIME, SKOS, etc. Elle est développée en utilisant la méthodologie SAMOD à travers des modelets successifs dirigés par un ensembe de questions de compétences qui reflètent des exigences utilisateurs."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "fr",
    "@value" : "Ontologie PIIRRITE Core"
  }, {
    "@language" : "en",
    "@value" : "PIIRRITE Core Ontology"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "piirrite"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "http://piirrite.univ-lyon1.fr/ontology/core#"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Ontology"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "http://qudt.org/2.1/schema/qudt#"
  }, {
    "@id" : "http://schemas.opengis.net/geosparql/1.0/geosparql_vocab_all.rdf"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#"
  }, {
    "@id" : "https://saref.etsi.org/core/v4.1.1/"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "http://piirrite.univ-lyon1.fr/ontology/core/1.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "1.0.0"
  } ]
}, {
  "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#AND",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#LogicalOperator"

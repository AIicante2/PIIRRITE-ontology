    "@language" : "fr",
    "@value" : "a pour type de distance"
  }, {
    "@language" : "en",
    "@value" : "has distance type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#hasFlexibility",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie une exigence à un réel entre 0 et 1 représentant le niveau de flexibilité que doit fournir le matching avec les propriétés contextuelles de l'environnement."
  }, {
    "@language" : "en",
    "@value" : "Links a requirement to a float between 0 and 1 representing the level of flexibility needed for the matching with contextual environmental properties."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#Requirement"
  } ],

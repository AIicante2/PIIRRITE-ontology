    "@language" : "fr",
    "@value" : "a pour flexibilité"
  }, {
    "@language" : "en",
    "@value" : "has flexibility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#Flexibility"
  } ]
}, {
  "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#hasImportance",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],

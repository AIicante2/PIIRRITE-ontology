    "@language" : "en",
    "@value" : "A condition that a spatial element should meet in order to be considered valid from the corresponding property standpoint."
  }, {
    "@language" : "fr",
    "@value" : "Une condition qu'un élément spatial doit respecter pour être considéré valide du point de vue de la propriété correspondante."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Atomic condition"
  }, {
    "@language" : "fr",
    "@value" : "Condition atomique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {

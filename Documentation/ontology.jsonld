}, {
  "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#ComparisonOperator",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An operator usable for the matching between a validity condition and the value of a contextual property. e.g. equality, membership, difference, superiority, etc."
  }, {
    "@language" : "fr",
    "@value" : "Un opérateur utilisable lors du matching entre une condition de validité et une valeur de propriété contextuelle. e.g. égalité, appartenance, différence, supériorité, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Comparison operator"
  }, {
    "@language" : "fr",
    "@value" : "Opérateur de comparaison"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {

  } ]
}, {
  "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#hasTemporalValidity",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie une valeur de propriété saref à sa fenêtre de validité temporelle, i.e. l'interval temporel pendant lequel la valeur est considérée valide. En l'absence de fenêtre de validité temporelle, celle-ci est considérée éternelle."
  }, {
    "@language" : "en",
    "@value" : "Links a saref property value to its temporal validity window, i.e. the temporal interval during which the value is considered valid. If the temporal validity window isn't specified, it is considered eternal."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://saref.etsi.org/core/v4.1.1/PropertyValue"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "a pour fenêtre de validité temporelle"
  }, {
    "@language" : "en",
    "@value" : "has temporal validity window"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2006/time#Interval"
  } ]
}, {
  "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#hasValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],

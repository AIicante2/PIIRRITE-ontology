    "@language" : "en",
    "@value" : "A condition composed of a logical operator and one or two operands that are themselves conditions."
  }, {
    "@language" : "fr",
    "@value" : "Une condition composée d'un opérateur logique et d'un ou deux opérande étant eux-mêmes des conditions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {

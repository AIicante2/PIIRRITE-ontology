    "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#DistanceFactor"
  } ]
}, {
  "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#hasDistanceType",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fr",
    "@value" : "Lie un facteur de distance à la façon dont elle est calculée, e.g. à vol d'oiseau, en suivant les chemins humains, en utilisant la propriété 'passe par'."
  }, {
    "@language" : "en",
    "@value" : "Links a distance factor to the way it is computed, e.g. from bird flight, by following humain pathways, by using the 'passes by' property."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#DistanceFactor"
  } ],

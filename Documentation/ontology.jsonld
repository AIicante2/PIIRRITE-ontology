    "@value" : "has operand"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#Condition"
  } ]
}, {
  "@id" : "http://piirrite.univ-lyon1.fr/ontology/core#hasRequiredValue",

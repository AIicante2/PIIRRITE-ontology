#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#anySimpleType
xsd:anySimpleType rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://piirrite.univ-lyon1.fr/ontology/core#hasAllowedValue
:hasAllowedValue rdf:type owl:ObjectProperty ;
                 rdfs:domain <https://saref.etsi.org/core/v4.1.1/Property> ;
                 rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                 rdfs:comment "Lie une propriété saref à la description d'une valeur qu'elle peut prendre."@fr ,
                              "Links a saref property to the description of a value it can have."@en ;
                 rdfs:label "a pour valeur autorisée"@fr ,
                            "has allowed value"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#hasCondition
:hasCondition rdf:type owl:ObjectProperty ;
              rdfs:domain :Requirement ;
              rdfs:range :Condition ;
              rdfs:comment "Lie une exigence a une condition."@fr ,
                           "Links a requirement to a condition."@en ;
              rdfs:label "a pour condition de validité"@fr ,
                         "has condition"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#hasDistanceFactor
:hasDistanceFactor rdf:type owl:ObjectProperty ;
                   rdfs:domain :AtomicCondition ;
                   rdfs:range :DistanceFactor ;
                   rdfs:comment "Lie une condition atomique à un facteur de distance."@fr ,
                                "Links an atomic conditon to a distance factor."@en ;
                   rdfs:label "a pour facteur de distance"@fr ,
                              "has distance factor"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#hasFlexibility
:hasFlexibility rdf:type owl:ObjectProperty ;
                rdfs:domain :Requirement ;
                rdfs:range :Flexibility ;
                rdfs:comment "Lie une exigence à un réel entre 0 et 1 représentant le niveau de flexibilité que doit fournir le matching avec les propriétés contextuelles de l'environnement."@fr ,
                             "Links a requirement to a float between 0 and 1 representing the level of flexibility needed for the matching with contextual environmental properties."@en ;
                rdfs:label "a pour flexibilité"@fr ,
                           "has flexibility"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#hasImportance
:hasImportance rdf:type owl:ObjectProperty ;
               rdfs:domain :Requirement ;
               rdfs:range :Importance ;
               rdfs:comment "Lie une exigence à son importance."@fr ,
                            "Links a requirement to its importance"@en ;
               rdfs:label "a pour importance"@fr ,
                          "has importance"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#hasOperand
:hasOperand rdf:type owl:ObjectProperty ;
            rdfs:domain :ComposedCondition ;
            rdfs:range :Condition ;
            rdfs:comment "Lie une condition composée à l'un de ses opérandes."@fr ,
                         "Links a composed condition to one of its operands."@en ;
            rdfs:label "a pour opérande"@fr ,
                       "has operand"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#hasRequirement
:hasRequirement rdf:type owl:ObjectProperty ;
                rdfs:domain :UserProfile ;
                rdfs:range :Requirement ;
                rdfs:comment "Lie un profil utilisateur à une exigence."@fr ,
                             "Links a user profile to a requirement."@en ;
                rdfs:label "a pour exigence"@fr ,
                           "has requirement"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#hasTargetProperty
:hasTargetProperty rdf:type owl:ObjectProperty ;
                   rdfs:domain :AtomicCondition ;
                   rdfs:range <https://saref.etsi.org/core/v4.1.1/Property> ;
                   rdfs:comment "Lie une condition à la propriété contextuelle à laquelle elle se rapporte."@fr ,
                                "Links a condition to the contextual property to which it relates."@en ;
                   rdfs:label "a pour propriété cible"@fr ,
                              "has target property"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#hasTemporalValidity
:hasTemporalValidity rdf:type owl:ObjectProperty ;
                     rdfs:domain <https://saref.etsi.org/core/v4.1.1/PropertyValue> ;
                     rdfs:range <http://www.w3.org/2006/time#Interval> ;
                     rdfs:comment "Lie une valeur de propriété saref à sa fenêtre de validité temporelle, i.e. l'interval temporel pendant lequel la valeur est considérée valide. En l'absence de fenêtre de validité temporelle, celle-ci est considérée éternelle."@fr ,
                                  "Links a saref property value to its temporal validity window, i.e. the temporal interval during which the value is considered valid. If the temporal validity window isn't specified, it is considered eternal."@en ;
                     rdfs:label "a pour fenêtre de validité temporelle"@fr ,
                                "has temporal validity window"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#passesBy
:passesBy rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :DistanceFactor
                                      :NavigablePath
                                    )
                      ] ;
          rdfs:range :PointOfInterest ;
          rdfs:comment "Lie un chemin navigable à un point d'intérêt par lequel il passe"@fr ,
                       "Links a navigable path to a point of interest it passes by"@en ;
          rdfs:label "passe par"@fr ,
                     "passes by"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#usesOperator
:usesOperator rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Condition
                                          :DistanceFactor
                                        )
                          ] ;
              rdfs:range :Operator ;
              rdfs:comment "Lie une condition à l'opérateur qui doit être employé lors du matching avec les propriétés contextulles de l'environnement."@fr ,
                           "Links a condition to the operator to use for the matching with contextual environmental properties."@en ;
              rdfs:label "uses operator"@en ,
                         "utilise l'opérateur"@fr .


###  http://qudt.org/schema/qudt/ansiSQLName
<http://qudt.org/schema/qudt/ansiSQLName> rdf:type owl:ObjectProperty .


###  http://qudt.org/schema/qudt/cName
<http://qudt.org/schema/qudt/cName> rdf:type owl:ObjectProperty .


###  http://qudt.org/schema/qudt/oracleSQLName
<http://qudt.org/schema/qudt/oracleSQLName> rdf:type owl:ObjectProperty .


###  http://qudt.org/schema/qudt/protocolBuffersName
<http://qudt.org/schema/qudt/protocolBuffersName> rdf:type owl:ObjectProperty .


###  http://qudt.org/schema/qudt/pythonName
<http://qudt.org/schema/qudt/pythonName> rdf:type owl:ObjectProperty .


###  http://qudt.org/schema/qudt/vbName
<http://qudt.org/schema/qudt/vbName> rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasDerivedFrom
<http://www.w3.org/ns/prov#wasDerivedFrom> rdf:type owl:ObjectProperty .


###  https://saref.etsi.org/core/v4.1.1/hasPropertyValue
<https://saref.etsi.org/core/v4.1.1/hasPropertyValue> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://piirrite.univ-lyon1.fr/ontology/core#hasDistanceType
:hasDistanceType rdf:type owl:DatatypeProperty ;
                 rdfs:domain :DistanceFactor ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Lie un facteur de distance à la façon dont elle est calculée, e.g. à vol d'oiseau, en suivant les chemins humains, en utilisant la propriété 'passe par'."@fr ,
                              "Links a distance factor to the way it is computed, e.g. from bird flight, by following humain pathways, by using the 'passes by' property."@en ;
                 rdfs:label "a pour type de distance"@fr ,
                            "has distance type"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#hasRequiredValue
:hasRequiredValue rdf:type owl:DatatypeProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :AtomicCondition
                                              :DistanceFactor
                                            )
                              ] ;
                  rdfs:range xsd:anySimpleType ;
                  rdfs:comment "Lie une condition à une valeur considérée comme valide."@fr ,
                               "Links a condition to a value that is considered valid."@en ;
                  rdfs:label "a pour valeur exigée"@fr ,
                             "has required value"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#hasValue
:hasValue rdf:type owl:DatatypeProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Flexibility
                                      :Importance
                                    )
                      ] ;
          rdfs:comment "Lie une enveloppe de valeur à sa valeur."@fr ,
                       "Links a value wrapper to its value."@en ;
          rdfs:label "a pour valeur"@fr ,
                     "has value"@en .


###  http://qudt.org/schema/qudt/bits
<http://qudt.org/schema/qudt/bits> rdf:type owl:DatatypeProperty .


###  http://qudt.org/schema/qudt/length
<http://qudt.org/schema/qudt/length> rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://piirrite.univ-lyon1.fr/ontology/core#AreaOfInterest
:AreaOfInterest rdf:type owl:Class ;
                rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ,
                                <https://saref.etsi.org/core/v4.1.1/FeatureOfInterest> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <https://saref.etsi.org/core/v4.1.1/hasPropertyValue> ;
                                  owl:someValuesFrom <https://saref.etsi.org/core/v4.1.1/PropertyValue>
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.opengis.net/ont/geosparql#hasGeometry> ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass <http://www.opengis.net/ont/sf#Polygon>
                                ] ;
                owl:disjointWith :PointOfInterest ,
                                 :PolylineOfInterest ;
                rdfs:comment "A 2D area over a geographic space represented as a polygon and contextualised by properties which are inherited by all context-faring entities contained within the area"@en ,
                             "Une région 2D d'un espace géographique représentée par un polygon et contextualisée par des propriétés qui sont hérités par toutes les entitées porteuses de contexte contenues dans la région"@fr ;
                rdfs:label "Area of Interest"@en ,
                           "Région d'intérêt"@fr .


###  http://piirrite.univ-lyon1.fr/ontology/core#AtomicCondition
:AtomicCondition rdf:type owl:Class ;
                 rdfs:subClassOf :Condition ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTargetProperty ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass <https://saref.etsi.org/core/v4.1.1/Property>
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :usesOperator ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :ComparisonOperator
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasDistanceFactor ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :DistanceFactor
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasRequiredValue ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:anySimpleType
                                 ] ;
                 owl:disjointWith :ComposedCondition ;
                 rdfs:comment "A condition that a spatial element should meet in order to be considered valid from the corresponding property standpoint."@en ,
                              "Une condition qu'un élément spatial doit respecter pour être considéré valide du point de vue de la propriété correspondante."@fr ;
                 rdfs:label "Atomic condition"@en ,
                            "Condition atomique"@fr .


###  http://piirrite.univ-lyon1.fr/ontology/core#ComparisonOperator
:ComparisonOperator rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( :EQUALS
                                                      :GREATER_THAN
                                                      :LESSER_THAN
                                                    )
                                        ] ;
                    rdfs:subClassOf :Operator ;
                    rdfs:comment "An operator usable for the matching between a validity condition and the value of a contextual property. e.g. equality, membership, difference, superiority, etc."@en ,
                                 "Un opérateur utilisable lors du matching entre une condition de validité et une valeur de propriété contextuelle. e.g. égalité, appartenance, différence, supériorité, etc."@fr ;
                    rdfs:label "Comparison operator"@en ,
                               "Opérateur de comparaison"@fr .


###  http://piirrite.univ-lyon1.fr/ontology/core#ComposedCondition
:ComposedCondition rdf:type owl:Class ;
                   rdfs:subClassOf :Condition ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasOperand ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Condition
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :usesOperator ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :LogicalOperator
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasOperand ;
                                     owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Condition
                                   ] ;
                   rdfs:comment "A condition composed of a logical operator and one or two operands that are themselves conditions."@en ,
                                "Une condition composée d'un opérateur logique et d'un ou deux opérande étant eux-mêmes des conditions."@fr ;
                   rdfs:label "Composed condition"@en ,
                              "Condition composée"@fr .


###  http://piirrite.univ-lyon1.fr/ontology/core#Condition
:Condition rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:unionOf ( :AtomicCondition
                                               :ComposedCondition
                                             )
                               ] ;
           rdfs:comment "A condition that a spatial element should meet in order to be considered valid."@en ,
                        "Une condition qu'un élément spatial doit respecter pour être considéré valide."@fr ;
           rdfs:label "Condition"@en ,
                      "Condition"@fr .


###  http://piirrite.univ-lyon1.fr/ontology/core#DistanceFactor
:DistanceFactor rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty :passesBy ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :PointOfInterest
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :usesOperator ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :ComparisonOperator
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasDistanceType ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasRequiredValue ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:anySimpleType
                                ] ;
                rdfs:comment "A distance factor for the corresponding condition to be considered respected."@en ,
                             "Un facteur de distance pour que la condition correspondante soit considérée respectée."@fr ;
                rdfs:label "Distance factor"@en ,
                           "Facteur de distance"@fr .


###  http://piirrite.univ-lyon1.fr/ontology/core#Flexibility
:Flexibility rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :hasValue ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange [ rdf:type rdfs:Datatype ;
                                                 owl:onDatatype xsd:decimal ;
                                                 owl:withRestrictions ( [ xsd:minInclusive 0.0
                                                                        ]
                                                                        [ xsd:maxInclusive 1.0
                                                                        ]
                                                                      )
                                               ]
                             ] ;
             rdfs:comment "A value wrapper representing the flexilibty of a requirement using a float between 0 and 1."@en ,
                          "Une enveloppe de valeur décrivant la flexibilité d'une exigence par un réel entre 0 et 1."@fr ;
             rdfs:label "Flexibility"@en ,
                        "Flexibilité"@fr .


###  http://piirrite.univ-lyon1.fr/ontology/core#Importance
:Importance rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :hasValue ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange [ rdf:type rdfs:Datatype ;
                                                owl:onDatatype xsd:decimal ;
                                                owl:withRestrictions ( [ xsd:minInclusive 0.0
                                                                       ]
                                                                       [ xsd:maxInclusive 1.0
                                                                       ]
                                                                     )
                                              ]
                            ] ;
            rdfs:comment "A value wrapper representing the importance of a requirement using a float between 0 and 1. The importance can also be equal to INF if the requirement is mandatory."@en ,
                         "Une enveloppe de valeur décrivant l'importance d'une exigence par un réel entre 0 et 1. L'importance peut également valoir INF si le besoin doit obligatoirement être respecté lors de la génération d'itinéraires."@fr ;
            rdfs:label "Importance"@en ,
                       "Importance"@fr .


###  http://piirrite.univ-lyon1.fr/ontology/core#LogicalOperator
:LogicalOperator rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( :AND
                                                   :NOT
                                                   :OR
                                                 )
                                     ] ;
                 rdfs:subClassOf :Operator ;
                 rdfs:comment "An operator usable for combining conditions into a composed validity expression."@en ,
                              "Un opérateur utilisable pour combiner des conditions en une expression de validité composée."@fr ;
                 rdfs:label "Logical operator"@en ,
                            "Opérateur logique"@fr .


###  http://piirrite.univ-lyon1.fr/ontology/core#NavigablePath
:NavigablePath rdf:type owl:Class ;
               rdfs:subClassOf :PolylineOfInterest ;
               rdfs:comment "A polyline of interest that can be traveled through"@en ,
                            "Une polyligne d'intérêt dont le parcours est possible"@fr ;
               rdfs:label "Chemin navigable"@fr ,
                          "Navigable path"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#Operator
:Operator rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Class ;
                                owl:unionOf ( :ComparisonOperator
                                              :LogicalOperator
                                            )
                              ] ;
          rdfs:comment "A comparison or logical operator."@en ,
                       "Un opérateur logique ou de comparaison."@fr ;
          rdfs:label "Operator"@en ,
                     "Opérateur"@fr .


###  http://piirrite.univ-lyon1.fr/ontology/core#PointOfInterest
:PointOfInterest rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ,
                                 <https://saref.etsi.org/core/v4.1.1/FeatureOfInterest> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <https://saref.etsi.org/core/v4.1.1/hasPropertyValue> ;
                                   owl:someValuesFrom <https://saref.etsi.org/core/v4.1.1/PropertyValue>
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://www.opengis.net/ont/geosparql#hasGeometry> ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass <http://www.opengis.net/ont/sf#Point>
                                 ] ;
                 owl:disjointWith :PolylineOfInterest ;
                 rdfs:comment "A dimensionless entity located in a geographic space and contextualised by properties"@en ,
                              "Une entité sans dimension localisée dans un espace géographique et contextualisée par des propriétés"@fr ;
                 rdfs:label "Point d'intérêt"@fr ,
                            "Point of Interest"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#PolylineOfInterest
:PolylineOfInterest rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ,
                                    <https://saref.etsi.org/core/v4.1.1/FeatureOfInterest> ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty <https://saref.etsi.org/core/v4.1.1/hasPropertyValue> ;
                                      owl:someValuesFrom <https://saref.etsi.org/core/v4.1.1/PropertyValue>
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty <http://www.opengis.net/ont/geosparql#hasGeometry> ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass <http://www.opengis.net/ont/sf#LineString>
                                    ] ;
                    rdfs:comment "A sequence of 1 or more consecutive segments located in a geographic space and contextualised by properties"@en ,
                                 "Une séquence d'1 ou plus segments consécutifs localisée dans un espace géographique et contextualisée par des propriétés"@fr ;
                    rdfs:label "Polyligne d'intérêt"@fr ,
                               "Polyline Of Interest"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#Requirement
:Requirement rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :hasCondition ;
                               owl:allValuesFrom :Condition
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasFlexibility ;
                               owl:allValuesFrom :Flexibility
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasImportance ;
                               owl:allValuesFrom :Importance
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasCondition ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Condition
                             ] ;
             rdfs:comment "A user requirement, represented by its importance, its rigor and one or many validity conditions"@en ,
                          "Une exigence d'un utilisateur, représentée par son importance, sa rigueur et une ou plusieurs conditions de validité."@fr ;
             rdfs:label "Exigence"@fr ,
                        "Requirement"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#UserProfile
:UserProfile rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :hasRequirement ;
                               owl:allValuesFrom :Requirement
                             ] ;
             rdfs:comment "A user profile, described by a set of requirement (eg. 'I want to use elevators') rather than by personnal characteristics (eg. I'm in a wheelchair)."@en ,
                          "Le profil d'un utilisateur, décrit par un ensemble d'exigences (eg. 'Je veux prendre l'ascenseur') plutôt que par des caractéristiques personnels (eg. 'Je suis en fauteuil')."@fr ;
             rdfs:label "Profil utilisateur"@fr ,
                        "User profile"@en .



@prefix : <http://piirrite.univ-lyon1.fr/ontology/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://piirrite.univ-lyon1.fr/ontology/core#> .

<http://piirrite.univ-lyon1.fr/ontology/core#> rdf:type owl:Ontology ;
                                                owl:versionIRI <http://piirrite.univ-lyon1.fr/ontology/core/1.0.0> ;
                                                owl:imports <http://qudt.org/2.1/schema/qudt#> ,
                                                            <http://schemas.opengis.net/geosparql/1.0/geosparql_vocab_all.rdf> ,
                                                            <http://www.w3.org/2004/02/skos/core#> ,
                                                            <https://saref.etsi.org/core/v4.1.1/> ;
                                                <http://purl.org/dc/terms/created> "2026-07-20"^^xsd:date ;
                                                <http://purl.org/dc/terms/creator> "Laboratoire d'InfoRmatique en Image et Systèmes d'information" ;
                                                <http://purl.org/dc/terms/description> "PIIRRITE (Pedestrian InclusIve indooR-outdooR ITinerariEs) is an ontology for inclusive pedestrian navigation. It relies on GeoSPARQL, SAREF, OWL-Time, SKOS, etc. It is developed using the SAMOD methodology through successive modelets driven by a set of competency questions reflecting user requirements."@en ,
                                                                                       "PIIRRITE (Pedestrion InclusIve indooR-outdooR ITinerariEs) est une ontologie pour la navigation piétonne inclusive. Elle repose sur GeoSPARQL, SAREF, OWL-TIME, SKOS, etc. Elle est développée en utilisant la méthodologie SAMOD à travers des modelets successifs dirigés par un ensembe de questions de compétences qui reflètent des exigences utilisateurs."@fr ;
                                                <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                <http://purl.org/dc/terms/title> "Ontologie PIIRRITE Core"@fr ,
                                                                                 "PIIRRITE Core Ontology"@en ;
                                                <http://purl.org/vocab/vann/preferredNamespacePrefix> "piirrite" ;
                                                <http://purl.org/vocab/vann/preferredNamespaceUri> "http://piirrite.univ-lyon1.fr/ontology/core#" ;
                                                owl:versionInfo "1.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/contributor
<http://purl.org/dc/elements/1.1/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
<http://purl.org/dc/elements/1.1/date> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/source
<http://purl.org/dc/elements/1.1/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://www.linkedmodel.org/schema/vaem#graphName
<http://www.linkedmodel.org/schema/vaem#graphName> rdf:type owl:AnnotationProperty .


###  http://www.linkedmodel.org/schema/vaem#graphTitle
<http://www.linkedmodel.org/schema/vaem#graphTitle> rdf:type owl:AnnotationProperty .


###  http://www.linkedmodel.org/schema/vaem#isMetadataFor
<http://www.linkedmodel.org/schema/vaem#isMetadataFor> rdf:type owl:AnnotationProperty .


###  http://www.linkedmodel.org/schema/vaem#website
<http://www.linkedmodel.org/schema/vaem#website> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2001/XMLSchema#maxInclusive
xsd:maxInclusive rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2001/XMLSchema#minInclusive
xsd:minInclusive rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2001/XMLSchema#pattern
xsd:pattern rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#maxQualifiedCardinality
owl:maxQualifiedCardinality rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#qualifiedCardinality
owl:qualifiedCardinality rdf:type owl:AnnotationProperty .


###  https://prez.dev/currentProfile
<https://prez.dev/currentProfile> rdf:type owl:AnnotationProperty .


###  https://prez.dev/description
<https://prez.dev/description> rdf:type owl:AnnotationProperty .


###  https://prez.dev/identifier
<https://prez.dev/identifier> rdf:type owl:AnnotationProperty .


###  https://prez.dev/label
<https://prez.dev/label> rdf:type owl:AnnotationProperty .


###  https://prez.dev/link
<https://prez.dev/link> rdf:type owl:AnnotationProperty .


###  https://prez.dev/members
<https://prez.dev/members> rdf:type owl:AnnotationProperty .


###  https://prez.dev/type
<https://prez.dev/type> rdf:type owl:AnnotationProperty .


###  https://schema.org/citation
<https://schema.org/citation> rdf:type owl:AnnotationProperty .


###  https://schema.org/contributor
<https://schema.org/contributor> rdf:type owl:AnnotationProperty .


###  https://schema.org/copyrightNotice
<https://schema.org/copyrightNotice> rdf:type owl:AnnotationProperty .


###  https://schema.org/coyrightNotice
<https://schema.org/coyrightNotice> rdf:type owl:AnnotationProperty .


###  https://schema.org/creator
<https://schema.org/creator> rdf:type owl:AnnotationProperty .


###  https://schema.org/dateCreated
<https://schema.org/dateCreated> rdf:type owl:AnnotationProperty .


###  https://schema.org/dateIssued
<https://schema.org/dateIssued> rdf:type owl:AnnotationProperty .


###  https://schema.org/dateModified
<https://schema.org/dateModified> rdf:type owl:AnnotationProperty .



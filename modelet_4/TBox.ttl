@prefix : <http://piirrite.univ-lyon1.fr/ontology/core#> .
@prefix sf: <http://www.opengis.net/ont/sf/1.1.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <https://www.w3.org/TR/owl-time/> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix piirrite: <http://piirrite.univ-lyon1.fr/ontology/core#> .
@base <http://piirrite.univ-lyon1.fr/ontology/core#> .

<http://piirrite.univ-lyon1.fr/ontology/core#> rdf:type owl:Ontology ;
                                                owl:imports <http://www.opengis.net/ont/geosparql#1.1> ,
                                                            <http://www.opengis.net/ont/sf/1.1.1> ,
                                                            <http://www.w3.org/2004/02/skos/core> ,
                                                            <https://saref.etsi.org/core/v4.1.1/> .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://piirrite.univ-lyon1.fr/ontology/core#hasAllowedValue
piirrite:hasAllowedValue rdf:type owl:ObjectProperty ;
                         rdfs:domain saref:Property ;
                         rdfs:range skos:Concept ;
                         rdfs:comment "Lie une propriété saref à la description d'une valeur qu'elle peut prendre."@fr ,
                                      "Links a saref property to the description of a value it can have."@en ;
                         rdfs:label "a pour valeur autorisée"@fr ,
                                    "has allowed value"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#hasTemporalValidity
piirrite:hasTemporalValidity rdf:type owl:ObjectProperty ;
                             rdfs:domain saref:PropertyValue ;
                             rdfs:range time:Interval ;
                             rdfs:comment "Lie une valeur de propriété saref à sa fenêtre de validité temporelle, i.e. l'interval temporel pendant lequel la valeur est considérée valide. En l'absence de fenêtre de validité temporelle, celle-ci est considérée éternelle."@fr ,
                                          "Links a saref property value to its temporal validity window, i.e. the temporal interval during which the value is considered valid. If the temporal validity window isn't specified, it is considered eternal."@en ;
                             rdfs:label "a pour fenêtre de validité temporelle"@fr ,
                                        "has temporal validity window"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#passesBy
piirrite:passesBy rdf:type owl:ObjectProperty ;
                  rdfs:domain piirrite:NavigablePath ;
                  rdfs:range piirrite:PointOfInterest ;
                  rdfs:comment "Lie un chemin navigable à un point d'intérêt par lequel il passe"@fr ,
                               "Links a navigable path to a point of interest it passes by"@en ;
                  rdfs:label "passe par"@fr ,
                             "passes by"@en .


piirrite:shortnessImportance rdf:type owl:DatatypeProperty ;
                        rdfs:domain piirrite:UserProfile ;
                        rdfs:range piirrite:rdfs:Literal ;
                        rdfs:comment "Lie un profil utilisateur à un réel entre 0 et 1 représentant l'importance que l'itinéraire proposé soit court."@fr,
                                     "Links a user profile to a float between 0 and 1 representing the importance that the proposed itinerary is small."@en ;
                        rdfs:label "a pour importance de concision"@fr,
                                   "has shortness importance"@en .


piirrite:hasImportance rdf:type owl:DatatypeProperty ;
                    rdfs:domain piirrite:Requirement ;
                    rdfs:range piirrite:Importance ;
                    rdfs:comment "Lie une exigence à son importance."@fr,
                                 "Links a requirement to its importance"@en ;
                    rdfs:label "a pour importance"@fr,
                               "has importance"@en .


piirrite:hasFlexibility rdf:type owl:DatatypeProperty ;
                     rdfs:domain piirrite:Requirement ;
                     rdfs:range piirrite:Flexibility ;
                     rdfs:comment "Lie une exigence à un réel entre 0 et 1 représentant le niveau de flexibilité que doit fournir le matching avec les propriétés contextuelles de l'environnement."@fr,
                                  "Links a requirement to a float between 0 and 1 representing the level of flexibility needed for the matching with contextual environmental properties."@en ;
                     rdfs:label "a pour flexibilité"@fr,
                                "has flexibility"@en .


piirrite:hasValue rdf:type owl:DatatypeProperty ;
                  rdfs:domain [
                      a owl:Class ;
                      owl:unionOf (
                          piirrite:Importance
                          piirrite:Flexibility
                      )
                  ] ;
                  rdfs:comment "Lie une enveloppe de valeur à sa valeur."@fr,
                      "Links a value wrapper to its value."@en ;
                  rdfs:label "a pour valeur"@fr,
                      "has value"@en .


piirrite:hasFlexibility rdf:type owl:DatatypeProperty ;
                     rdfs:domain piirrite:Requirement ;
                     rdfs:range xsd:decimal ;
                     rdfs:comment "Lie une exigence à un réel entre 0 et 1 représentant le niveau de flexibilité que doit fournir le matching avec les propriétés contextuelles de l'environnement."@fr,
                                  "Links a requirement to a float between 0 and 1 representing the level of flexibility needed for the matching with contextual environmental properties."@en ;
                     rdfs:label "a pour flexibilité"@fr,
                                "has flexibility"@en .


piirrite:hasCondition rdf:type owl:ObjectProperty ;
                              rdfs:domain piirrite:Requirement ;
                              rdfs:range piirrite:Condition ;
                              rdfs:comment "Lie une exigence a une condition."@fr,
                                           "Links a requirement to a condition."@en ;
                              rdfs:label "a pour condition de validité"@fr,
                                         "has condition"@en .


piirrite:hasTargetProperty rdf:type owl:ObjectProperty ;
                           rdfs:domain piirrite:Condition ;
                           rdfs:range saref:Property ;
                           rdfs:comment "Lie une condition à la propriété contextuelle à laquelle elle se rapporte."@fr,
                                        "Links a condition to the contextual property to which it relates."@en ;
                           rdfs:label "a pour propriété cible"@fr,
                                      "has target property"@en .


piirrite:hasRequiredValue rdf:type owl:DatatypeProperty ;
                          rdfs:domain piirrite:Condition ;
                          rdfs:range xsd:anySimpleType ;
                          rdfs:comment "Lie une condition à une valeur considérée comme valide."@fr,
                                       "Links a condition to a value that is considered valid."@en ;
                          rdfs:label "a pour valeur exigée"@fr,
                                     "has required value"@en .


piirrite:usesOperator rdf:type owl:ObjectProperty ;
                          rdfs:domain piirrite:Condition ;
                          rdfs:range piirrite:Operator ;
                          rdfs:comment "Lie une condition à l'opérateur qui doit être employé lors du matching avec les propriétés contextulles de l'environnement."@fr,
                                       "Links a condition to the operator to use for the matching with contextual environmental properties."@en ;
                          rdfs:label "utilise l'opérateur"@fr,
                                     "uses operator"@en .


#################################################################
#    Classes
#################################################################

###  http://piirrite.univ-lyon1.fr/ontology/core#AreaOfInterest
piirrite:AreaOfInterest rdf:type owl:Class ;
                        rdfs:subClassOf geo:Feature ,
                                        saref:FeatureOfInterest ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty saref:hasPropertyValue ;
                                          owl:someValuesFrom saref:PropertyValue
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty geo:hasGeometry ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass sf:Polygon
                                        ] ;
                        owl:disjointWith piirrite:PointOfInterest ,
                                         piirrite:PolylineOfInterest ;
                        rdfs:comment "A 2D area over a geographic space represented as a polygon and contextualised by properties which are inherited by all context-faring entities contained within the area"@en ,
                                     "Une région 2D d'un espace géographique représentée par un polygon et contextualisée par des propriétés qui sont hérités par toutes les entitées porteuses de contexte contenues dans la région"@fr ;
                        rdfs:label "Area of Interest"@en ,
                                   "Région d'intérêt"@fr .


###  http://piirrite.univ-lyon1.fr/ontology/core#NavigablePath
piirrite:NavigablePath rdf:type owl:Class ;
                       rdfs:subClassOf piirrite:PolylineOfInterest ;
                       rdfs:comment "A polyline of interest that can be traveled through"@en ,
                                    "Une polyligne d'intérêt dont le parcours est possible"@fr ;
                       rdfs:label "Chemin navigable"@fr ,
                                  "Navigable path"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#PointOfInterest
piirrite:PointOfInterest rdf:type owl:Class ;
                         rdfs:subClassOf geo:Feature ,
                                         saref:FeatureOfInterest ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty saref:hasPropertyValue ;
                                           owl:someValuesFrom saref:PropertyValue
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty geo:hasGeometry ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass sf:Point
                                         ] ;
                         owl:disjointWith piirrite:PolylineOfInterest ;
                         rdfs:comment "A dimensionless entity located in a geographic space and contextualised by properties"@en ,
                                      "Une entité sans dimension localisée dans un espace géographique et contextualisée par des propriétés"@fr ;
                         rdfs:label "Point d'intérêt"@fr ,
                                    "Point of Interest"@en .


###  http://piirrite.univ-lyon1.fr/ontology/core#PolylineOfInterest
piirrite:PolylineOfInterest rdf:type owl:Class ;
                            rdfs:subClassOf geo:Feature ,
                                            saref:FeatureOfInterest ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty saref:hasPropertyValue ;
                                              owl:someValuesFrom saref:PropertyValue
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty geo:hasGeometry ;
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass sf:LineString
                                            ] ;
                            rdfs:comment "A sequence of 1 or more consecutive segments located in a geographic space and contextualised by properties"@en ,
                                         "Une séquence d'1 ou plus segments consécutifs localisée dans un espace géographique et contextualisée par des propriétés"@fr ;
                            rdfs:label "Polyligne d'intérêt"@fr ,
                                       "Polyline Of Interest"@en .


piirrite:UserProfile rdf:type owl:Class ;
                     rdfs:subClassOf [
                         rdf:type owl:Restriction ;
                         owl:onProperty piirrite:shortnessImportance ;
                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange [
                             rdf:type rdfs:Datatype ;
                             owl:onDatatype xsd:decimal ;
                             owl:withRestrictions (
                                 [ xsd:minInclusive "0.0"^^xsd:decimal ]
                                 [ xsd:maxInclusive "1.0"^^xsd:decimal ]
                             )
                         ]
                     ] ,
                     rdfs:subClassOf [
                         rdf:type owl:Restriction ;
                         owl:onProperty piirrite:hasRequirement ;
                         owl:allValuesFrom piirrite:Requirement
                     ] ;
                     rdfs:comment "Le profil d'un utilisateur, décrit par un ensemble d'exigences (eg. 'Je veux prendre l'ascenseur') plutôt que par des caractéristiques personnels (eg. 'Je suis en fauteuil')."@fr,
                                  "A user profile, described by a set of requirement (eg. 'I want to use elevators') rather than by personnal characteristics (eg. I'm in a wheelchair)."@en ;
                     rdfs:label "Profil utilisateur"@fr,
                                "User profile"@en .


piirrite:Requirement rdf:type owl:Class ;
                     rdfs:subClassOf [
                         rdf:type owl:Restriction ;
                         owl:onProperty piirrite:hasImportance ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:allValuesFrom piirrite:Importance
                     ] ,
                     [
                         rdf:type owl:Restriction ;
                         owl:onProperty piirrite:hasFlexibility ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:allValuesFrom piirrite:Flexibility
                     ] ,
                     [
                         rdf:type owl:Restriction ;
                         owl:onProperty piirrite:hasCondition ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass piirrite:Condition
                     ] ,
                     [
                         rdf:type owl:Restriction ;
                         owl:onProperty piirrite:hasCondition ;
                         owl:allValuesFrom piirrite:Condition
                     ] ;
                     rdfs:comment "Une exigence d'un utilisateur, représentée par son importance, sa rigueur et une ou plusieurs conditions de validité."@fr,
                                  "A user requirement, represented by its importance, its rigor and one or many validity conditions"@en ;
                     rdfs:label "Exigence"@fr,
                                "Requirement"@en .


piirrite:Importance rdf:type owl:Class ;
                    rdfs:subClassOf [
                         rdf:type owl:Restriction ;
                         owl:onProperty piirrite:hasValue ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange [
                             rdf:type rdfs:Datatype ;
                             owl:onDatatype xsd:decimal ;
                             owl:withRestrictions (
                                 [ xsd:minInclusive "0.0"^^xsd:decimal ]
                                 [ xsd:maxInclusive "1.0"^^xsd:decimal ]
                             )
                         ]
                     ] ;
                    rdfs:comment "Une enveloppe de valeur décrivant l'importance d'une exigence par un réel entre 0 et 1. L'importance peut également valoir INF si le besoin doit obligatoirement être respecté lors de la génération d'itinéraires."@fr,
                        "A value wrapper representing the importance of a requirement using a float between 0 and 1. The importance can also be equal to INF if the requirement is mandatory."@en ;
                    rdfs:label "Importance"@fr,
                        "Importance"@en .


piirrite:Flexibility rdf:type owl:Class ;
                    rdfs:subClassOf [
                         rdf:type owl:Restriction ;
                         owl:onProperty piirrite:hasValue ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange [
                             rdf:type rdfs:Datatype ;
                             owl:onDatatype xsd:decimal ;
                             owl:withRestrictions (
                                 [ xsd:minInclusive "0.0"^^xsd:decimal ]
                                 [ xsd:maxInclusive "1.0"^^xsd:decimal ]
                             )
                         ]
                     ] ;
                    rdfs:comment "Une enveloppe de valeur décrivant la flexibilité d'une exigence par un réel entre 0 et 1."@fr,
                        "A value wrapper representing the flexilibty of a requirement using a float between 0 and 1."@en ;
                    rdfs:label "Flexibilité"@fr,
                        "Flexibility"@en .


piirrite:Condition rdf:type owl:Class ;
                   rdfs:subClassOf [
                       rdf:type owl:Restriction ;
                       owl:onProperty piirrite:hasTargetProperty ;
                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass saref:Property
                   ] ,
                   [
                       rdf:type owl:Restriction ;
                       owl:onProperty piirrite:hasRequiredValue ;
                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onDataRange xsd:anySimpleType
                   ] ,
                   [
                       rdf:type owl:Restriction ;
                       owl:onProperty piirrite:usesOperator ;
                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass piirrite:Operator
                   ] ;
                   rdfs:comment "Une condition qu'un élément spatial doit respecter pour être considéré valide du point de vue de la propriété correspondante."@fr,
                                "A condition that a spatial element should meet in order to be considered valid from the corresponding property standpoint."@en ;
                   rdfs:label "Condition"@fr,
                              "Condition"@en .


piirrite:Operator rdf:type owl:Class ;
                  owl:equivalentClass [
                      rdf:type owl:Class ;
                      owl:oneOf (
                          piirrite:Equals
                          piirrite:NotEquals
                          piirrite:GreaterThan
                          piirrite:LessThan
                      )
                  ] ;
                  rdfs:comment "Un opérateur utilisable lors du matching entre une condition de validité et une valeur de propriété contextuelle environnementale. e.g. égalité, appartenance, différence, supériorité, etc."@fr,
                               "An operator usable for the matching between a validity condition and the value of a contextual environmental property. e.g. equality, membership, difference, superiority, etc."@en ;
                  rdfs:label "Opérateur"@fr,
                             "Operator"@en .


piirrite:Equals rdf:type piirrite:Operator ;
                rdfs:label "égal à"@fr ,
                           "equals"@en .


piirrite:NotEquals rdf:type piirrite:Operator ;
                   rdfs:label "différent de"@fr ,
                              "not equals"@en .


piirrite:GreaterThan rdf:type piirrite:Operator ;
                     rdfs:label "supérieur à"@fr ,
                                "greater than"@en .


piirrite:LessThan rdf:type piirrite:Operator ;
                  rdfs:label "inférieur à"@fr ,
                             "less than"@en .


piirrite:In rdf:type piirrite:Operator ;
                  rdfs:label "dans"@fr ,
                             "in"@en .

###  http://www.opengis.net/ont/sf/1.1.1/LineString
sf:LineString rdf:type owl:Class .


###  http://www.opengis.net/ont/sf/1.1.1/Point
sf:Point rdf:type owl:Class .


###  http://www.opengis.net/ont/sf/1.1.1/Polygon
sf:Polygon rdf:type owl:Class .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#List
rdf:List rdf:type owl:Class .


###  http://www.w3.org/2000/01/rdf-schema#Class
rdfs:Class rdf:type owl:Class .


###  http://www.w3.org/2000/01/rdf-schema#Container
rdfs:Container rdf:type owl:Class .


###  http://www.w3.org/2000/01/rdf-schema#Datatype
rdfs:Datatype rdf:type owl:Class .


###  https://www.w3.org/TR/owl-time/Interval
time:Interval rdf:type owl:Class .



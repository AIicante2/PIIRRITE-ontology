pcv:S_Aerialway a skos:ConceptScheme ;
    skos:definition "Used for various forms of transport for passengers and goods that use wires, including cable-cars, chair-lifts and drag-lifts."@en ;
    skos:prefLabel "Aerialway"@en .

pcv:S_Cemetery a skos:ConceptScheme ;
    skos:definition "Specifies parts of a cemetery, single graves or special kinds of cemeteries."@en ;
    skos:prefLabel "Cemetery"@en .

pcv:S_Clothes a skos:ConceptScheme ;
    skos:definition "Tagged on shops and other features to denote if they sell clothes or not and what type of clothes they sell.  group = shops  onNode = yes  onWay = no  onArea = yes  onRelation = no  requires = {{ tag  shop  clothes }}, or {{ tag  shop  sports }}, or such  combination =  seeAlso = * {{ tag  shop  boutique }} * {{ tag  shop  outdoor }} * {{ tag  shop  shoes }} * {{ tag  shop  sports }}  status = de facto  statuslink ="@en ;
    skos:prefLabel "Clothes"@en .

pcv:S_DeparturesBoard a skos:ConceptScheme ;
    skos:definition "Specifies the presence (or type) of an associated board in an airport, train station, bus terminal or stop, etc displaying the information about future departures."@en ;
    skos:prefLabel "Departures board"@en .

pcv:S_Education a skos:ConceptScheme ;
    skos:definition "Schools, kindergartens, universities, and other educational features."@en ;
    skos:prefLabel "Education"@en .

pcv:S_Electrified a skos:ConceptScheme ;
    skos:definition "Indicates infrastructure to supply vehicles with electricity, on rail tracks or highways."@en ;
    skos:prefLabel "Electrified"@en .

pcv:S_Government a skos:ConceptScheme ;
    skos:definition "Indicates the subtypes of government agencies and institutions."@en ;
    skos:prefLabel "Government"@en .

pcv:S_Hazard a skos:ConceptScheme ;
    skos:definition "A hazardous or dangerous feature."@en ;
    skos:prefLabel "Hazard"@en .


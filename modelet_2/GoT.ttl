    skos:definition "Maximum time you are allowed to stay somewhere."@en ;
    skos:prefLabel "Maxstay"@en .

pcv:S_OfficialName a skos:ConceptScheme ;
    skos:definition "The official name of the feature, or the name as used by governments and other official organizations. Usually tagged when object has unwieldy and typically not used name that was officially assigned."@en ;
    skos:prefLabel "Official name"@en .

pcv:S_Oneway a skos:ConceptScheme ;
    skos:definition "Linear features that users can only go one direction in. Used in highways, zip lines, and other features."@en ;
    skos:prefLabel "Oneway"@en .

pcv:S_OpeningHours a skos:ConceptScheme,
        saref:Property ;
    piirrite:hasAllowedValue pcv:value_3cec07e9ba5f5bb252d13f5f431e4bbb ;
    skos:definition "Describes when something is open or closed in a standard format."@en ;
    skos:prefLabel "Opening hours"@en .

pcv:S_Placement a skos:ConceptScheme,
        saref:Property ;
    piirrite:hasAllowedValue pcv:value_1007b597b37073bd6a3e1c32b2686976,
        pcv:value_230b82de8346ffc78f4f12e31618cee3,
        pcv:value_3b4465aee81af3f2ef5ba27514aef842,
        pcv:value_5122ee599fcc4558f7e2545994e2de22,
        pcv:value_a5280b3d530aaa664ad1884a5f321018,
        pcv:value_be3fda264a50162c42cff383019b9190,
        pcv:value_dde2901143ecdf37e07077237f96d9f4 ;
    skos:definition "Used to specify the placement of the OSM-way relative to the road it represents."@en ;
    skos:prefLabel "Placement"@en .

pcv:S_PriorityRoad a skos:ConceptScheme ;
    skos:definition "Specifies whether a road is a signposted priority road or the type of a signposted priority road."@en ;
    skos:prefLabel "Priority road"@en .

pcv:S_Psv a skos:ConceptScheme ;
    skos:definition "Access permission for Public Service Vehicles: buses, taxis, minibuses and share taxis."@en ;
    skos:prefLabel "Psv"@en .

pcv:S_Pump a skos:ConceptScheme ;
    skos:definition "Presence and technology of a pump on a source of water."@en ;
    skos:prefLabel "Pump"@en .

pcv:S_Ramp a skos:ConceptScheme ;
    skos:definition "Whether a ramp for bicycles, strollers, wheelchairs and/or luggage is built into a stairway"@en ;
    skos:prefLabel "Ramp"@en .

pcv:S_RouteMaster a skos:ConceptScheme ;
    skos:definition "Defines the type of vehicle operated on a public transport route_master relation"@en ;
    skos:prefLabel "Route master"@en .

pcv:S_Ruins a skos:ConceptScheme ;
    skos:definition "Indicate that a structure is in ruins or specifies the type of ruins of an tag:historic=ruins."@en ;
    skos:prefLabel "Ruins"@en .

pcv:S_Seasonal a skos:ConceptScheme ;
    skos:definition "Describes features that depend on seasonal conditions"@en ;
    skos:prefLabel "Seasonal"@en .

pcv:S_ShortName a skos:ConceptScheme ;
    skos:definition "A recognizable, commonly used short version of the main name."@en ;
    skos:prefLabel "Short name"@en .

pcv:S_Smoking a skos:ConceptScheme ;
    skos:definition "For marking applicable smoking rules. However, if a law mandates a given smoking rule, that need not be mapped."@en ;
    skos:prefLabel "Smoking"@en .

pcv:S_Snowmobile a skos:ConceptScheme ;
    skos:definition "Used to describe the legal access for snowmobiles."@en ;
    skos:prefLabel "Snowmobile"@en .

pcv:S_Status a skos:ConceptScheme ;
    skos:definition "group="@en ;
    skos:prefLabel "Status"@en .

pcv:S_Stop a skos:ConceptScheme ;
    skos:definition "A junction at which vehicles on some or all approaches must stop."@en ;
    skos:prefLabel "Stop"@en .

pcv:S_Takeaway a skos:ConceptScheme ;
    skos:definition "Whether the restaurant offers meals for pick-up that can be consumed elsewhere."@en ;
    skos:prefLabel "Takeaway"@en .

pcv:S_Trailblazed a skos:ConceptScheme ;
    skos:definition "Markings on outdoor paths and trails by signs, markers, poles, cairns or in another way."@en ;
    skos:prefLabel "Trailblazed"@en .

